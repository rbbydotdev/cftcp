{
  // The Worker is prebuilt by src/build.sh (`npm run build`); `npm run dev` runs
  // it locally with `wrangler dev`, `npm run deploy` ships it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "do-box",
  "main": "dist/worker.js",
  "no_bundle": true,
  "base_dir": "dist",
  "find_additional_modules": true,
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false }],
  "compatibility_date": "2026-11-01",
  // experimental: required by @cloudflare/computer's Worker shell backend.
  "compatibility_flags": ["nodejs_compat", "experimental"],

  "durable_objects": {
    "bindings": [
      { "name": "BOX", "class_name": "Box" },
      { "name": "DB", "class_name": "ProjectDb" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Box", "ProjectDb"] }],

  // Dynamic Workers for bash (Worker shell), run_js (Codemode) and run_python.
  "worker_loaders": [{ "binding": "LOADER" }],

  // Workers AI: pi's default models, no API key needed (src/workers-ai.mjs).
  "ai": { "binding": "AI" },

  "vars": {
    // Where pi tells you to look at what it built (set to your workers.dev URL).
    "PREVIEW_URL": "https://do-box.YOUR-SUBDOMAIN.workers.dev",
    // Shown by the admin TUI (ssh admin@…) as "ssh <project>@SSH_HOST".
    "SSH_HOST": "box.example.com -p 2222",
    // Time limits: disconnect after this many idle minutes / session hours;
    // per-call timeout for run_python (run_js has 60 s).
    "IDLE_TIMEOUT_MIN": "30",
    "MAX_SESSION_HOURS": "8",
    "RUN_TIMEOUT_S": "120"
  },
  // Secrets (wrangler secret put …):
  //   AUTHORIZED_KEYS   your SSH public key(s), one per line. Required: no keys = no logins.
  //   PREVIEW_TOKEN     open https://do-box.<you>.workers.dev/?token=… to view projects.
  //   Optional: OPENROUTER_API_KEY / ANTHROPIC_API_KEY for other providers (Workers AI needs none).

  "observability": { "enabled": true },

  // Local only (`npm run dev`): the SSH port. In production, Spectrum routes
  // TCP to the Worker instead (DEPLOY.md).
  "connect": [{ "protocol": "tcp", "port": 2222 }]
}
